# MODELO do .env do banco do servidor RFID. Copie para .env (na mesma pasta do docker-compose.yml) e troque a senha.
# O .env com a senha de verdade NÃO vai para o git: guarde com as senhas da empresa.
# A mesma senha vai no config\application.properties do servidor (spring.datasource.password).

# Senha do banco: longa e aleatória (ex.: 32 caracteres, só letras e números para não precisar de aspas)
RFID_DB_PASSWORD=troque-por-uma-senha-longa

# Nome do banco e usuário (o servidor usa estes por padrão)
RFID_DB_NOME=rfid
RFID_DB_USER=rfid

# Porta na máquina (5433 para não disputar com outro PostgreSQL na 5432)
RFID_DB_PORTA=5433

# Pasta dos backups no Windows (relativa a esta pasta ou caminho completo, ex.: D:/Backups/RFID)
RFID_BACKUP_PASTA=./backups

# Quantos backups guardar: diários, semanais e mensais
RFID_BACKUP_DIAS=14
RFID_BACKUP_SEMANAS=4
RFID_BACKUP_MESES=6
